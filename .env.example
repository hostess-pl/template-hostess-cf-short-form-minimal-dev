SITE_URL=https://hostess-template.<your-subdomain>.workers.dev

# Set true for local review toolbar on localhost (pnpm dev)
REVIEW_MODE_ENABLED=false

# Per-client slug (optional — defaults to hostess.json slug)
HOSTESS_SLUG=
# Preview worker suffix (optional — defaults to hostess.json submissionId)
PREVIEW_ID=

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Hostess Portfolio <noreply@yourdomain.com>
RESEND_TO=manager@yourdomain.com

CHECK_ORIGIN=true

# Client-side analytics (baked at build time for prerendered pages)
PUBLIC_CONSENT_ENABLED=true
PUBLIC_ANALYTICS_ENABLED=true

# Supabase analytics (shared project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TRACKING_ENABLED=false
ANALYTICS_SALT=
ANALYTICS_ENV=preview
RATE_LIMIT_SALT=

# Preview feedback access codes
REVIEW_ADMIN_CODE=
REVIEW_CLIENT_CODE=
REVIEW_AUTH_SALT=

# Review completion webhook (ops sync via sync-gh-secrets.sh)
REVIEW_WEBHOOK_SECRET=
N8N_REVIEW_COMPLETE_URL=https://ops.ilurodigital.com/webhook/hostess-review-complete

# Cloudflare (for deploy:preview / GHA)
CLOUDFLARE_API_TOKEN=
# Account workers.dev subdomain (e.g. hostesspl → preview-id.hostesspl.workers.dev)
WORKERS_DEV_SUBDOMAIN=hostesspl
