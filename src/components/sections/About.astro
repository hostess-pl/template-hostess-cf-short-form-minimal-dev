---
import { appearanceFacts, content } from '@/config/content';
import Chip from '@/components/ui/Chip.astro';
import FactCard from '@/components/ui/FactCard.astro';
import { locales } from '@/config/site.config';

const strengthsLabel: Record<(typeof locales)[number], string> = {
  en: 'Strengths',
  pl: 'Atuty',
  es: 'Fortalezas',
};

const hasEducation = locales.some((locale) => content.about[locale].education.degrees.length > 0);
const hasCurrentWork = locales.some((locale) => content.about[locale].currentWork.entries.length > 0);
const hasStrengths = locales.some((locale) => content.strengths[locale].length > 0);
const hasFacts = appearanceFacts.length > 0;
const hasBody = locales.some((locale) => Boolean(content.about[locale].body));
---

<section id="about" data-review-id="about-section" class="border-t border-border bg-background-secondary/40 py-14 md:py-18">
  <div class="container">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:items-start">
      <div>
        {locales.map((locale) => (
          <p class="section-label mb-3" data-lang={locale}>{content.about[locale].label}</p>
        ))}
        <h2 class="font-display text-3xl text-foreground md:text-4xl">
          {locales.map((locale) => (
            <span data-lang={locale}>{content.about[locale].title}</span>
          ))}
        </h2>
        <p data-review-target="about-lead" class="mt-5 text-lg leading-relaxed text-foreground">
          {locales.map((locale) => (
            <span data-lang={locale}>{content.about[locale].lead}</span>
          ))}
        </p>
        {hasBody ? (
          <p class="mt-4 text-foreground-muted">
            {locales.map((locale) => (
              <span data-lang={locale}>{content.about[locale].body}</span>
            ))}
          </p>
        ) : null}

        {hasFacts ? (
          locales.map((locale) => (
            <div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3" data-lang={locale}>
              {appearanceFacts.map((fact) => (
                <FactCard icon={fact.icon} label={fact.label[locale]} value={fact.value[locale]} />
              ))}
            </div>
          ))
        ) : null}
      </div>

      <div class="space-y-5">
        {hasEducation || hasCurrentWork ? (
          locales.map((locale) => (
            <div class="rounded-2xl border border-border bg-card p-5 md:p-6" data-lang={locale}>
              {hasEducation ? (
                <div>
                  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent">
                    {content.about[locale].education.label}
                  </p>
                  <div class="mt-4 flex flex-col gap-3">
                    {content.about[locale].education.degrees.map((degree) => (
                      <div class="rounded-xl border border-border/80 bg-background-secondary/40 px-4 py-3">
                        <div class="flex items-start justify-between gap-4">
                          <div>
                            <p class="font-display text-base leading-snug text-foreground">{degree.name}</p>
                            {degree.university ? (
                              <p class="mt-1 text-sm text-foreground-muted">{degree.university}</p>
                            ) : null}
                          </div>
                          {degree.year ? (
                            <p class="shrink-0 text-sm text-accent">{degree.year}</p>
                          ) : null}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : null}

              {hasCurrentWork ? (
                <div class={hasEducation ? 'mt-6 border-t border-border/70 pt-6' : ''}>
                  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent">
                    {content.about[locale].currentWork.label}
                  </p>
                  <div class="mt-4 flex flex-col gap-3">
                    {content.about[locale].currentWork.entries.map((entry) => (
                      <div class="flex items-center justify-between gap-4 rounded-xl border border-border/80 bg-background-secondary/40 px-4 py-3">
                        <p class="font-display text-base leading-snug text-foreground">{entry.name}</p>
                        {entry.year ? (
                          <p class="shrink-0 text-sm text-accent">{entry.year}</p>
                        ) : null}
                      </div>
                    ))}
                  </div>
                </div>
              ) : null}
            </div>
          ))
        ) : null}

        {hasStrengths ? (
          <div>
            {locales.map((locale) => (
              <p class="mb-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-foreground-subtle" data-lang={locale}>
                {strengthsLabel[locale]}
              </p>
            ))}
            {locales.map((locale) => (
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-lang={locale}>
                {content.strengths[locale].map((strength) => (
                  <Chip text={strength} />
                ))}
              </div>
            ))}
          </div>
        ) : null}
      </div>
    </div>
  </div>
</section>
