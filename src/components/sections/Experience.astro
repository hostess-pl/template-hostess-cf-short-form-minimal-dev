---
import { content, backgroundEntries } from '@/config/content';
import { locales } from '@/config/site.config';
---

<section id="experience" data-review-id="experience-section" class="py-14 md:py-20">
  <div class="container max-w-3xl">
    {locales.map((locale) => (
      <p class="section-label mb-3" data-lang={locale}>{content.background[locale].label}</p>
    ))}
    <h2 class="font-display text-3xl text-foreground md:text-4xl">
      {locales.map((locale) => (
        <span data-lang={locale}>{content.background[locale].title}</span>
      ))}
    </h2>
    {locales.some((locale) => Boolean(content.background[locale].subtitle)) ? (
      <p class="mt-3 text-foreground-muted">
        {locales.map((locale) => (
          <span data-lang={locale}>{content.background[locale].subtitle}</span>
        ))}
      </p>
    ) : null}

    <div class="mt-8 divide-y divide-border rounded-2xl border border-border bg-card">
      {backgroundEntries.map((entry) => (
        <article class="flex flex-col gap-2 px-5 py-5 sm:flex-row sm:items-start sm:gap-6 md:px-7">
          <time class="shrink-0 text-xs font-semibold uppercase tracking-[0.14em] text-accent sm:w-28">
            {locales.map((locale) => (
              <span data-lang={locale}>{entry.date[locale]}</span>
            ))}
          </time>
          <div>
            <h3 class="font-display text-lg text-foreground">
              {locales.map((locale) => (
                <span data-lang={locale}>{entry.title[locale]}</span>
              ))}
            </h3>
            <p class="mt-1 text-sm text-foreground-muted">
              {locales.map((locale) => (
                <span data-lang={locale}>{entry.description[locale]}</span>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
