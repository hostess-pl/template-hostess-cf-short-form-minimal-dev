---
import { Image, getImage } from 'astro:assets';
import { content, galleryEvents } from '@/config/content';
import { locales } from '@/config/site.config';

const showMoreLabel: Record<(typeof locales)[number], string> = {
  en: 'Show more',
  pl: 'Pokaż więcej',
  es: 'Ver más',
};

function isLowCropEvent(event: { id: string; title: Record<string, string> }): boolean {
  if (event.id === 'sopot') return true;
  return Object.values(event.title).some((t) => /molo/i.test(t || ''));
}

const galleryItems = await Promise.all(
  galleryEvents.map(async (event) => {
    const src =
      event.image.kind === 'remote'
        ? event.image.src
        : (await getImage({ src: event.image.meta, width: 1400, height: 1050, format: 'webp' })).src;
    return {
      id: event.id,
      src,
      video: event.video ?? null,
      lowCrop: isLowCropEvent(event),
      date: event.date,
      title: event.title,
      description: event.description,
      alt: event.alt,
    };
  }),
);

const initialVisible = 3;
const hasMoreEvents = galleryEvents.length > initialVisible;
---

<section id="gallery" data-review-id="gallery-section" class="border-t border-border py-14 md:py-20">
  <div class="container">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        {locales.map((locale) => (
          <p class="section-label mb-3" data-lang={locale}>{content.gallery[locale].label}</p>
        ))}
        <h2 class="font-display text-3xl text-foreground md:text-4xl">
          {locales.map((locale) => (
            <span data-lang={locale}>{content.gallery[locale].title}</span>
          ))}
        </h2>
        <p class="mt-3 text-foreground-muted">
          {locales.map((locale) => (
            <span data-lang={locale}>{content.gallery[locale].subtitle}</span>
          ))}
        </p>
      </div>
    </div>

    <div id="gallery-grid" class="mt-10 grid gap-6 md:grid-cols-2" data-visible={initialVisible}>
      {galleryEvents.map((event, index) => (
        <article
          class:list={[
            'gallery-card group cursor-pointer overflow-hidden rounded-2xl border border-border bg-card text-left transition-shadow hover:shadow-[0_20px_50px_-28px_rgba(42,38,34,0.35)]',
            index === 0 && 'md:col-span-2 md:grid md:grid-cols-2',
            index >= initialVisible && 'hidden',
          ]}
          data-gallery-id={event.id}
          data-gallery-index={index}
          role="button"
          tabindex="0"
          aria-label={`View ${event.title.en}`}
        >
          <div class:list={['relative overflow-hidden', index === 0 && 'md:h-full']}>
            {event.image.kind === 'local' ? (
              <Image
                src={event.image.meta}
                alt={event.alt.en}
                widths={[480, 720, 960]}
                sizes={index === 0 ? '(max-width: 768px) 100vw, 50vw' : '(max-width: 768px) 100vw, 40vw'}
                class:list={[
                  'w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]',
                  index === 0 ? 'aspect-[16/10] md:h-full md:min-h-[280px]' : 'aspect-[4/3]',
                  isLowCropEvent(event) && 'object-[center_42%]',
                ]}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            ) : (
              <img
                src={event.image.src}
                alt={event.alt.en}
                class:list={[
                  'w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]',
                  index === 0 ? 'aspect-[16/10] md:h-full md:min-h-[280px]' : 'aspect-[4/3]',
                  isLowCropEvent(event) && 'object-[center_42%]',
                ]}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            )}
            {event.video && (
              <span class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full border border-border/80 bg-background/95 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-foreground shadow-sm">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M4.5 2.5v7l5.5-3.5-5.5-3.5z" fill="currentColor" />
                </svg>
                <span data-lang="en">Photo + Video</span>
                <span data-lang="pl">Zdjęcie + Wideo</span>
                <span data-lang="es">Foto + Video</span>
              </span>
            )}
          </div>
          <div class="flex flex-col justify-center p-5 md:p-6">
            {(locales.some((locale) => Boolean(event.title[locale]?.trim())) || event.date || locales.some((locale) => Boolean(event.description[locale]?.trim()))) ? (
              <>
                <div class="flex items-start justify-between gap-3">
                  {locales.some((locale) => Boolean(event.title[locale]?.trim())) ? (
                    <h3 class="font-display text-xl text-foreground">
                      {locales.map((locale) => (
                        <span data-lang={locale}>{event.title[locale]}</span>
                      ))}
                    </h3>
                  ) : <span />}
                  {event.date ? (
                    <span class="shrink-0 text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-accent">{event.date}</span>
                  ) : null}
                </div>
                {locales.some((locale) => Boolean(event.description[locale]?.trim())) ? (
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-foreground-muted">
                    {locales.map((locale) => (
                      <span data-lang={locale}>{event.description[locale]}</span>
                    ))}
                  </p>
                ) : null}
              </>
            ) : null}
          </div>
        </article>
      ))}
    </div>

    {hasMoreEvents ? (
      <div class="mt-8 flex justify-center">
        <button
          type="button"
          id="gallery-show-more"
          class="inline-flex items-center gap-2 border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
        >
          {locales.map((locale) => (
            <span data-lang={locale}>{showMoreLabel[locale]}</span>
          ))}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    ) : null}
  </div>

  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div id="gallery-lightbox-backdrop" class="absolute inset-0 bg-foreground/55 backdrop-blur-sm"></div>

    <div
      id="gallery-lightbox-panel"
      class="relative z-10 flex max-h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-[0_32px_80px_-24px_rgba(42,38,34,0.45)] md:max-h-[85vh] md:flex-row"
    >
      <button
        type="button"
        id="gallery-lightbox-close"
        class="absolute right-3 top-3 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background/95 text-foreground transition-colors hover:bg-accent hover:text-background"
        aria-label="Close"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>

      <div
        id="gallery-lightbox-media"
        class="relative min-h-[220px] bg-background-secondary md:min-h-0 md:w-1/2"
      >
        <img id="gallery-lightbox-image" src="" alt="" class="h-full w-full object-cover object-center" />
        <video
          id="gallery-lightbox-video"
          class="hidden h-full w-full object-cover object-center"
          controls
          playsinline
          preload="metadata"
        ></video>

        <button
          type="button"
          id="gallery-lightbox-prev"
          class="absolute left-3 top-1/2 z-10 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/95 text-foreground shadow-sm transition-colors hover:bg-accent hover:text-background flex"
          aria-label="Previous"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="block shrink-0">
            <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <button
          type="button"
          id="gallery-lightbox-next"
          class="absolute right-3 top-1/2 z-10 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/95 text-foreground shadow-sm transition-colors hover:bg-accent hover:text-background flex"
          aria-label="Next"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="block shrink-0">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <p
          id="gallery-lightbox-slide-label"
          class="absolute top-3 left-1/2 z-10 hidden -translate-x-1/2 rounded-full border border-border/80 bg-background/95 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-foreground-subtle"
        ></p>
      </div>

      <div class="flex flex-col justify-center overflow-y-auto p-6 md:w-1/2 md:p-8">
        <p id="gallery-lightbox-date" class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-accent"></p>
        <h3 id="gallery-lightbox-title" class="mt-2 font-display text-2xl text-foreground md:text-3xl"></h3>
        <p id="gallery-lightbox-description" class="mt-4 text-base leading-relaxed text-foreground-muted"></p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ galleryItems }}>
  const lightbox = document.getElementById('gallery-lightbox');
  const backdrop = document.getElementById('gallery-lightbox-backdrop');
  const panel = document.getElementById('gallery-lightbox-panel');
  const closeBtn = document.getElementById('gallery-lightbox-close');
  const mediaEl = document.getElementById('gallery-lightbox-media');
  const imageEl = document.getElementById('gallery-lightbox-image');
  const videoEl = document.getElementById('gallery-lightbox-video');
  const prevBtn = document.getElementById('gallery-lightbox-prev');
  const nextBtn = document.getElementById('gallery-lightbox-next');
  const slideLabel = document.getElementById('gallery-lightbox-slide-label');
  const titleEl = document.getElementById('gallery-lightbox-title');
  const dateEl = document.getElementById('gallery-lightbox-date');
  const descEl = document.getElementById('gallery-lightbox-description');

  if (
    lightbox &&
    backdrop &&
    panel &&
    closeBtn &&
    mediaEl &&
    imageEl &&
    videoEl &&
    prevBtn &&
    nextBtn &&
    slideLabel &&
    titleEl &&
    dateEl &&
    descEl
  ) {
    const itemsById = Object.fromEntries(galleryItems.map((item) => [item.id, item]));
    let activeItem = null;
    let activeSlide = 0;
    let touchStartX = 0;

    const slideLabels = {
      en: { photo: 'Photo', video: 'Video', of: 'of' },
      pl: { photo: 'Zdjęcie', video: 'Wideo', of: 'z' },
      es: { photo: 'Foto', video: 'Video', of: 'de' },
    };

    function getLocale() {
      const locale = document.documentElement.dataset.locale;
      if (locale === 'pl' || locale === 'es') return locale;
      return 'en';
    }

    function hasVideo(item) {
      return Boolean(item?.video);
    }

    function pauseVideo() {
      videoEl.pause();
      videoEl.currentTime = 0;
      videoEl.removeAttribute('src');
      videoEl.load();
    }

    function updateSlideUI() {
      const locale = getLocale();
      const labels = slideLabels[locale];
      const itemHasVideo = hasVideo(activeItem);

      prevBtn.classList.toggle('hidden', !itemHasVideo);
      nextBtn.classList.toggle('hidden', !itemHasVideo);
      slideLabel.classList.toggle('hidden', !itemHasVideo);

      if (!itemHasVideo) {
        imageEl.classList.remove('hidden');
        videoEl.classList.add('hidden');
        pauseVideo();
        return;
      }

      if (activeSlide === 0) {
        imageEl.classList.remove('hidden');
        videoEl.classList.add('hidden');
        pauseVideo();
        slideLabel.textContent = `${labels.photo} 1 ${labels.of} 2`;
        prevBtn.setAttribute('aria-label', labels.photo);
        nextBtn.setAttribute('aria-label', labels.video);
      } else {
        imageEl.classList.add('hidden');
        videoEl.classList.remove('hidden');
        if (videoEl.getAttribute('src') !== activeItem.video) {
          videoEl.src = activeItem.video;
          videoEl.load();
        }
        slideLabel.textContent = `${labels.video} 2 ${labels.of} 2`;
        prevBtn.setAttribute('aria-label', labels.photo);
        nextBtn.setAttribute('aria-label', labels.video);
      }
    }

    function openLightbox(id) {
      const item = itemsById[id];
      if (!item) return;

      activeItem = item;
      activeSlide = 0;

      const locale = getLocale();
      imageEl.src = item.src;
      imageEl.alt = item.alt[locale];
      imageEl.classList.toggle('object-[center_42%]', Boolean(item.lowCrop));
      imageEl.classList.toggle('object-center', !item.lowCrop);
      titleEl.textContent = item.title[locale];
      dateEl.textContent = item.date;
      descEl.textContent = item.description[locale];

      updateSlideUI();

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      imageEl.src = '';
      pauseVideo();
      activeItem = null;
      activeSlide = 0;
    }

    function goToSlide(index) {
      if (!hasVideo(activeItem)) return;
      activeSlide = index === 0 ? 0 : 1;
      updateSlideUI();
    }

    function goNext() {
      if (!hasVideo(activeItem)) return;
      goToSlide(activeSlide === 0 ? 1 : 0);
    }

    function goPrev() {
      if (!hasVideo(activeItem)) return;
      goToSlide(activeSlide === 0 ? 1 : 0);
    }

    document.querySelectorAll('.gallery-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-gallery-id');
        if (id) openLightbox(id);
      });
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          const id = card.getAttribute('data-gallery-id');
          if (id) openLightbox(id);
        }
      });
    });

    prevBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      goPrev();
    });

    nextBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      goNext();
    });

    mediaEl.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
      },
      { passive: true },
    );

    mediaEl.addEventListener(
      'touchend',
      (event) => {
        if (!hasVideo(activeItem)) return;
        const touchEndX = event.changedTouches[0]?.clientX ?? 0;
        const delta = touchEndX - touchStartX;
        if (Math.abs(delta) < 40) return;
        if (delta < 0) goNext();
        else goPrev();
      },
      { passive: true },
    );

    closeBtn.addEventListener('click', closeLightbox);
    backdrop.addEventListener('click', closeLightbox);
    panel.addEventListener('click', (event) => event.stopPropagation());

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.classList.contains('hidden')) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowRight') goNext();
      if (event.key === 'ArrowLeft') goPrev();
    });
  }

  const showMoreBtn = document.getElementById('gallery-show-more');
  const galleryGrid = document.getElementById('gallery-grid');
  if (showMoreBtn && galleryGrid) {
    const step = 3;
    let visible = Number(galleryGrid.dataset.visible || step);
    const cards = Array.from(galleryGrid.querySelectorAll('.gallery-card'));

    showMoreBtn.addEventListener('click', () => {
      visible = Math.min(visible + step, cards.length);
      cards.forEach((card, index) => {
        if (index < visible) card.classList.remove('hidden');
      });
      galleryGrid.dataset.visible = String(visible);
      if (visible >= cards.length) {
        showMoreBtn.classList.add('hidden');
      }
    });
  }
</script>
