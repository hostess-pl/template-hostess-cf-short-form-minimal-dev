---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="flex h-full min-h-[2.75rem] w-full items-center justify-center rounded-lg border border-border/70 bg-card px-2.5 py-2 text-center text-[0.7rem] font-medium leading-snug tracking-wide text-foreground sm:min-h-0 sm:px-3 sm:py-2.5 sm:text-xs">
  {text}
</span>
