---
import type { AppearanceFactIcon } from '@/config/content';
import heightIcon from '@/assets/icons/height-svgrepo-com.svg?raw';
import dressIcon from '@/assets/icons/chiffon-dress-svgrepo-com.svg?raw';
import hairIcon from '@/assets/icons/female-hairs-svgrepo-com.svg?raw';

interface Props {
  label: string;
  value: string;
  icon: AppearanceFactIcon;
  class?: string;
}

const { label, value, icon, class: className = '' } = Astro.props;

const assetIcons: Partial<Record<AppearanceFactIcon, string>> = {
  height: heightIcon,
  dress: dressIcon,
  hair: hairIcon,
};

const assetHtml = assetIcons[icon] ?? '';
---

<div class={`flex items-center gap-3 rounded-xl border border-border bg-card px-3 py-2.5 ${className}`}>
  <span
    class:list={['fact-icon', 'flex', 'h-8', 'w-8', 'shrink-0', 'items-center', 'justify-center', 'text-accent', assetHtml ? 'fact-icon--asset' : '']}
    aria-hidden="true"
  >
    {assetHtml ? (
      <Fragment set:html={assetHtml} />
    ) : icon === 'eyes' ? (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
        <circle cx="12" cy="12" r="2.5" />
      </svg>
    ) : icon === 'license' ? (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="9" cy="12" r="2.2" />
        <path d="M14 10.5h4M14 13.5h3" />
      </svg>
    ) : (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M5 16h14l-1.2-4.2A2 2 0 0 0 15.9 10H8.1a2 2 0 0 0-1.9 1.8L5 16Z" />
        <path d="M7 16v2M17 16v2M8.5 10l1-3h5l1 3" />
      </svg>
    )}
  </span>
  <div class="min-w-0">
    <p class="text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-foreground-subtle">{label}</p>
    <p class="truncate font-display text-base leading-tight text-foreground">{value}</p>
  </div>
</div>

<style>
  .fact-icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .fact-icon--asset :global(svg),
  .fact-icon--asset :global(path),
  .fact-icon--asset :global(rect) {
    fill: currentColor;
  }
</style>
