---
/**
 * Minimal branded 404 — no hostess load (missing routes must stay light).
 */
import '@/styles/global.css';

export const prerender = false;

Astro.response.status = 404;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Nie znaleziono — 404</title>
  </head>
  <body class="font-sans antialiased">
    <main class="flex min-h-screen flex-col items-center justify-center px-6 py-16 text-center">
      <p class="text-[0.7rem] uppercase tracking-[0.22em] text-accent">404</p>
      <h1 class="mt-4 font-display text-3xl text-foreground md:text-4xl">Nie znaleziono strony</h1>
      <p class="mt-3 max-w-md text-foreground-muted">
        Ta strona nie istnieje lub została przeniesiona.
      </p>
      <p class="mt-1 max-w-md text-sm text-foreground-subtle" lang="en">
        This page does not exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-10 inline-flex items-center justify-center border border-border-strong bg-foreground px-6 py-3 text-[0.72rem] font-medium uppercase tracking-[0.16em] text-background transition-colors hover:bg-accent hover:text-foreground"
      >
        Wróć na stronę główną
      </a>
    </main>
  </body>
</html>
