{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hostess-tpl-base-cms",
  "compatibility_date": "2026-01-31",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "vars": {
    "SITE_URL": "https://hostess-tpl-base-cms.hostesspl.workers.dev",
    "CHECK_ORIGIN": "true",
    "SUPABASE_TRACKING_ENABLED": "true",
    "ANALYTICS_ENV": "production",
    "PUBLIC_CONSENT_ENABLED": "false",
    "PUBLIC_ANALYTICS_ENABLED": "true",
    "PUBLIC_SUPABASE_URL": "https://tdkxfaordqpoofqpyvjo.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRka3hmYW9yZHFwb29mcXB5dmpvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQyOTg3NTcsImV4cCI6MjA5OTg3NDc1N30.EsevKOM9xKcnb8CHaA6VHlgzjGyKuSP-GT18w35w7x8",
    "PUBLIC_CMS_SITE_SLUG": "tpl-base",
    "CMS_SITE_SLUG": "tpl-base"
  }
}
